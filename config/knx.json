{
  "client": {
    "type": "TUNNELING",
    "addressFormat": "LONG",
    "gatewayIp": "192.168.131.1",
    "gatewayPort": 3671,
    "localIp": "192.168.131.129",
    "autoReconnect": true,
    "autoReconnectWait": 3,
    "gatewaysScanner": { "enabled": false }
  },
  "devices": [
    {
      "deviceInfo": {
        "deviceNameDataType": "string",
        "deviceNameExpressionSource": "constant",
        "deviceNameExpression": "Living Room",
        "deviceProfileDataType": "none",
        "deviceProfileExpressionSource": "constant",
        "deviceProfileNameExpression": "default"
      },
      "pollPeriod": 5000,
      "timeseries": [
        { "type": "percent", "key": "blindPosition", "groupAddress": "2/1/3" },
        { "type": "temperature", "key": "roomTemp", "groupAddress": "3/1/2" },
        { "type": "temperature", "key": "setpointDisplay", "groupAddress": "4/3/3" }
      ],
      "attributes": []
    }
  ],
  "attributeUpdates": [
    { "deviceNameFilter": ".*", "dataType": "switch",  "groupAddress": "1/1/1", "key": "light" },
    { "deviceNameFilter": ".*", "dataType": "switch",  "groupAddress": "2/1/1", "key": "blindMove" },
    { "deviceNameFilter": ".*", "dataType": "switch",  "groupAddress": "2/1/2", "key": "blindStop" },
    { "deviceNameFilter": ".*", "dataType": "percent", "groupAddress": "4/4/2", "key": "valveHeat" },
    { "deviceNameFilter": ".*", "dataType": "setpoint_heat_user", "groupAddress": "4/1/2", "key": "targetSetpoint" }
  ],
  "serverSideRpc": [
    { "requestType": "write", "deviceNameFilter": ".*", "method": "setState",    "dataType": "switch",             "groupAddress": "1/1/1" },
    { "requestType": "write", "deviceNameFilter": ".*", "method": "setSetpoint", "dataType": "setpoint_heat_user", "groupAddress": "4/1/2" }
  ],
  "name": "KNX",
  "id": "REPLACE-WITH-YOUR-CONNECTOR-ID"
}
